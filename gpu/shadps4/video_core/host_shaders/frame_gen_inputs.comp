// bbport: frame generation's depth input, taken where the upscaler runs (before the game's
// post-processing): the scene depth as R32F. The motion vectors come from CameraMotion.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex; // D32 depth aspect, render size
layout(binding = 1, r32f) uniform writeonly image2D depth_img;

layout(push_constant) uniform Constants {
    vec2 size; // render pixels
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
        return;
    }
    imageStore(depth_img, pixel, vec4(texelFetch(depth_tex, pixel, 0).r, 0.0, 0.0, 0.0));
}
