#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0,rgba16f) uniform readonly image2D source_image;
layout(binding=1,rgba8) uniform writeonly image2D target_image;
layout(push_constant) uniform Size {uvec2 extent;} params;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(p),params.extent))) return;
    imageStore(target_image,p,imageLoad(source_image,p));
}
