+extern "C" FfxVkFsr3_3_1_6FrameGenerationResult
+ffxVkFsr3_3_1_6FrameGenerationContextSetDispatchDebugFlags(
+    FfxVkFsr3_3_1_6FrameGenerationContext* context, uint32_t flags)
+{
+    if (!context)
+        return FFX_VK_FSR3_3_1_6_FRAMEGEN_ERROR_INVALID_ARGUMENT;
+    const uint32_t allowed = FFX_VK_FSR3_3_1_6_FRAMEGEN_DISPATCH_DRAW_DEBUG_VIEW;
+    if ((flags & ~allowed) != 0u)
+        return FFX_VK_FSR3_3_1_6_FRAMEGEN_ERROR_INVALID_ARGUMENT;
+    context->dispatchDebugFlags = flags;
+    return FFX_VK_FSR3_3_1_6_FRAMEGEN_OK;
