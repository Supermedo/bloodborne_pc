#include <winver.h>
1 VERSIONINFO
 FILEVERSION @BBPORT_VERSION_RC@
 PRODUCTVERSION @BBPORT_VERSION_RC@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Bloodborne native Windows port"
      VALUE "FileVersion", "@BBPORT_VERSION_FULL@"
      VALUE "ProductName", "Bloodborne (bbport)"
      VALUE "ProductVersion", "v@BBPORT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
